DATABASE_URL=postgresql://user:password@localhost:5432/zyphron
AUTH_SECRET=change_me_32_chars_minimum_secure_random_string
NEXTAUTH_SECRET=change_me_32_chars_minimum_secure_random_string
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_password
SMTP_SECURE=false
SMTP_FROM_NAME=Zyphron Cloud
SMTP_FROM_EMAIL=no-reply@zyphron.cloud
SMTP_REPLY_TO=support@zyphron.cloud

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_TASKS=
DISCORD_CHANNEL_ANNOUNCEMENTS=

WHMCS_API_URL=https://billing.zyphron.cloud/includes/api.php
WHMCS_API_IDENTIFIER=
WHMCS_API_SECRET=

PAYMENTER_API_URL=
PAYMENTER_API_KEY=

PTERODACTYL_API_URL=
PTERODACTYL_API_KEY=

FILE_STORAGE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Storage — Local (private) for dev, S3-compatible for production (AWS S3, R2, MinIO, B2)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=zyphron-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Real-time (Socket.IO) — optional Redis for scaling presence/typing/rate-limit
REDIS_URL=redis://localhost:6379
SOCKET_URL=http://localhost:3000
